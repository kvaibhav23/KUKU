# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for live LLM calls.
ANTHROPIC_API_KEY=

# Optional. Without it, voice input is off and the app says so (Phase 5).
SARVAM_API_KEY=

# Optional. Used only to show rupee costs. See docs/DECISIONS.md D-010.
# USD_TO_INR=94.0

# Set to 1 to run tests/test_llm_live.py, which makes small paid API calls.
SABOOT_LIVE_TESTS=0
